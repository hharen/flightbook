<% content_for :title, t('.title') %>

<div class="login-container">
  <h1><%= t('.title') %></h1>

  <% if flash[:alert] %>
    <p class="flash-alert"><%= flash[:alert] %></p>
  <% end %>

  <%= form_with url: session_path, method: :post do |form| %>
    <div>
      <%= form.label :email, style: "display: block" %>
      <%= form.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <div>
      <%= form.label :password, style: "display: block" %>
      <%= form.password_field :password, autocomplete: "current-password" %>
    </div>

    <div>
      <%= form.submit t('.submit'), class: "btn btn-primary" %>
    </div>
  <% end %>

  <div class="login-invite">
    <h2><%= t('.invite_heading') %></h2>
    <p><%= t('.invite_body_html', email: mail_to("hi@hharen.com")) %></p>
  </div>
</div>

<div class="login-preview">
  <h2><%= t('.preview_heading') %></h2>
  <%= image_tag "sessions_index_preview_#{I18n.locale}.png", alt: t('.title'), class: "login-preview-img" %>
</div>
