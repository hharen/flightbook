<%= form_with(model: instructor) do |form| %>
  <% if instructor.errors.any? %>
    <div style="color: red">
      <h2><%= t('instructors.form.error_header', count: instructor.errors.count) %></h2>

      <ul>
        <% instructor.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div class="form-actions">
    <%= form.submit t("instructors.form.#{instructor.persisted? ? 'update_button' : 'create_button'}") %>
    <% if instructor.persisted? %>
      <%= link_to t('instructors.edit.delete_button'), instructor_path(instructor),
                  data: { turbo_method: :delete },
                  class: "btn btn-danger" %>
    <% end %>
  </div>
<% end %>
